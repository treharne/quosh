[Unit]
Description=Quosh remote shell daemon
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/quosh-server --bind 0.0.0.0:443 --socket /run/quosh/quosh.sock --data-dir /var/lib/quosh
Restart=on-failure
RestartSec=2
TimeoutStopSec=8
KillMode=mixed
RuntimeDirectory=quosh
RuntimeDirectoryMode=0755
StateDirectory=quosh
StateDirectoryMode=0755
# Root is required to bind UDP 443 and to setuid to the SSH user.
User=root

[Install]
WantedBy=multi-user.target
